        440,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Split each markdown doc into one chunk per '## ' section.\n// chunk id = <doc-id>#<section-slug>  (this is the citation id used by the Ask workflow)\nconst slug = s => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');\nconst out = [];\nfor (const item of $input.all()) {\n  const raw = item.json.text || '';\n  const m = raw.match(/^---\\n([\\s\\S]*?)\\n---\\n([\\s\\S]*)$/);\n  if (!m) continue;\n  const meta = {};\n  for (const line of m[1].split('\\n')) {\n    const k = line.match(/^([a-z_]+):\\s*(.*)$/);\n    if (k) meta[k[1]] = k[2].replace(/^\"|\"$/g, '');\n  }\n  const parts = m[2].split(/^## /m).slice(1);\n  for (const p of parts) {\n    const nl = p.indexOf('\\n');\n    const section = p.slice(0, nl).trim();\n    const body = p.slice(nl + 1).trim();\n    out.push({ json: {\n      chunk_id: `${meta.id}#${slug(section)}`,\n      doc_id: meta.id, section, company: meta.company, doc_type: meta.doc_type,\n      title: meta.title, version: meta.version, status: meta.status,\n      text: body,\n      embed_text: `${meta.title} - ${section}\\n${body}`,\n    }});\n  }\n}\nreturn out;"
      },
      "id": "chunk-documents",
      "name": "Chunk Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:11434/api/embed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'all-minilm:33m', input: $json.embed_text }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 0
            }
          },
          "timeout": 60000
        }
      },
      "id": "embed-chunk-(ollama-all-minilm)",
      "name": "Embed Chunk (Ollama all-minilm)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pair every chunk with its embedding and assemble the vector index (JSON).\nconst chunks = $('Chunk Documents').all();\nconst embs = $input.all();\nconst r5 = v => Math.round(v * 1e5) / 1e5;\nconst rows = chunks.map((c, i) => {\n  const e = embs[i].json.embeddings[0];\n  const { embed_text, ...rest } = c.json;\n  return { ...rest, embedding: e.map(r5) };\n});\nconst index = {\n  embed_model: 'all-minilm:33m',\n  created_at: new Date().toISOString(),\n  doc_count: new Set(rows.map(r => r.doc_id)).size,\n  chunk_count: rows.length,\n  dim: rows[0].embedding.length,\n  chunks: rows,\n};\nreturn [{ json: { json_text: JSON.stringify(index), doc_count: index.doc_count, chunk_count: index.chunk_count, dim: index.dim } }];"
      },
      "id": "build-vector-index",
      "name": "Build Vector Index",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
